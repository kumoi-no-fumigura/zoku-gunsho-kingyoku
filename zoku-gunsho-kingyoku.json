  {
   "seq": "4",
   "text": "しつみはつるいる日のきはにあらはれてかすめる山の猶興のみね",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "5",
   "text": "うき世にはよしなき梅のにをひかな色に心をとめしとおもふに",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "6",
   "text": "梅かゝは枕にみちてうくひすの声よりあくるまとのしのゝめ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "7",
   "text": "あかしかぬるね覚のおもひつきもせすたゝ秋のよのねやのはる雨",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "左",
   "dai": "衛門"
  },
  {
   "seq": "8",
   "text": "霞くるゝ夕日の空にふりそめてしつかになれるとひの春雨",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "",
   "dai": "衛門"
  },
  {
   "seq": "9",
   "text": "しられすも心のそこや春になる時なるころと春のまたるゝ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "10",
   "text": "梅かえはむつきのころの花にしてさくらは末のやよひきさしき",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "",
   "dai": ""
  },
  {
   "seq": "11",
   "text": "末たるゝ極のいとをつたふ雨のしつくもなかき春の日くらし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "12",
   "text": "霞ふかみしられぬ雲もたぢやそふのしけき空は雨に成ぬる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "13",
   "text": "山さくら棗のうちにうつさはやまつは久しきあたし日かすを",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "14",
   "text": "思そめき四の時には老のはる春のうちには明本のゝそら",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "",
   "dai": ""
  },
  {
   "seq": "15",
   "text": "尤をなかぬ暮の音を聞なしてことおもひなき春の日くらし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "左",
   "dai": ":"
  },
  {
   "seq": "16",
   "text": "春ことに花の所とたつねてもこぬおくのこるみよしのゝ山",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": ":"
  },
  {
   "seq": "17",
   "text": "雨をやむ梢にあらき夕あらししつくも花もともにおつなり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "18",
   "text": "外まてはさそはぬ花のなさけそへて木本めくる庭の春かせ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "19",
   "text": "とまれにし春こそかきりありとても尤は日数をさためやはする",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "20",
   "text": "めくりゆかは春には又もあふとそもけふのこよひは後にしもあらし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "21",
   "text": "をしや猶桜山吹ちりゑをれ春なりぬへき給ふのけしきを",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "22",
   "text": "夕つくる紅花かきにかけそひて軒端にちかく水鶏鳴なり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "",
   "dai": ""
  },
  {
   "seq": "23",
   "text": "今とまつめくれことのあらましにきかてなれぬる郭公かな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "左",
   "dai": "・"
  },
  {
   "seq": "24",
   "text": "ほとゝきす人のまとろむ程とてやゑのふる比はふけてこそなけ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "",
   "dai": "・"
  },
  {
   "seq": "25",
   "text": "くれぬかや思ふなかめのさなからに夕へさひしき五月雨の空",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "26",
   "text": "五月雨は所々にたきおちて見ぬ山川の数そゝひゆく",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "27",
   "text": "月や出るほしの光のかくるかなすゝしき風のゆふやみのそら",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十四",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "28",
   "text": "川むかひ柳のあたり水みえてすゝしき陰に鷺あそふなり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "29",
   "text": "一方に木ゝにこすゑをふきかへし夕立おくる風そ涼しき",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "30",
   "text": "あをみわたるしはふの色も涼しきはつはなさゆるゝ夏の夕暮",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十五",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "31",
   "text": "我もかなし草木も心いたむらん秋風ふれて露くたるころ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十六",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "32",
   "text": "哀しか夕くれことに亀そゝふ秋こしはりの袖のしらつゆ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十六",
   "side": "",
   "dai": ""
  },
  {
   "seq": "33",
   "text": "なひきかへり花の末より露ちりて萩のはしろし庭の秋かせ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "34",
   "text": "露をもる小萩か末はなひきふして吹かへす風に花そ色そふ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "",
   "dai": ""
  },
  {
   "seq": "35",
   "text": "萩のうへ尾花か末もしつるにて秋風みえぬゆふ暮のには",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十八",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "36",
   "text": "暮はてゝ千草わかれぬ秋の庭に尾花はかりそ風にほのめく",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "37",
   "text": "袖の涙草葉の露の夕まくれ秋にしほれぬよの色もなし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "38",
   "text": "一露の色ましはの風の夕けしきあすもやとにたへてなかめん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "十九",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "39",
   "text": "ふけぬともなかむる程はおほえぬに月より西のそゝそすくなき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "40",
   "text": "月のほる峯の秋風ふきぬらしふもとのきりそ色くたりゆく",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿",
   "side": "",
   "dai": ""
  },
  {
   "seq": "41",
   "text": "むかし今ゆく未かけておもひ出ぬこよひ一夜の月のあはれに",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "42",
   "text": "いかなりし人のなさけるおもひ出るこしかたかたれ秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿一",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "43",
   "text": "まとしらむ軒はの空は明そめて枕のうへにきゆる月かけ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿二",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "44",
   "text": "更ゆけは千里の外もしつまりて月にすみぬるよのけしきかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿二",
   "side": "",
   "dai": ""
  },
  {
   "seq": "45",
   "text": "雲になく雁かね寒し長月や木葉色つく秋風の暮",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿三",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "46",
   "text": "夕日うつる梅か末の秋風にそなたのかりのさゑもさひしき",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "47",
   "text": "露ふかきまた朝かけの草かくれよのまの虫のこゑそ残れる",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿四",
   "side": "左",
   "dai": "、"
  },
  {
   "seq": "48",
   "text": "まつくす木末にましる松の色のひとりさめたる秋の山もと",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "49",
   "text": "一心とめて草木の色も詠おかん面かけにたる秋やのこると",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿五",
   "side": "",
   "dai": ""
  },
  {
   "seq": "50",
   "text": "嵐のみこたへぬ枝にふき過て木葉のあとの山そさひしき",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿六",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "51",
   "text": "暁の時雨のなこり地かゝらし庭のおちはもまたぬれてみゆ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "52",
   "text": "盃もくたり水もこほるやあめ公のさむきをうくる心なるらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "53",
   "text": "さゆる日も雨はくたるをいかなれはこほれる河の水とまるらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿七",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "54",
   "text": "ふりつもるよな〳〵ことにをれそひて盃にしかるゝ庭のくれ竹",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿八",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "55",
   "text": "くるしまてしはしははらふ竹の葉に風はよはりて盃そふりゆく",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿八",
   "side": "",
   "dai": ""
  },
  {
   "seq": "56",
   "text": "山あらしの杉のはゝらふ曙にむら〳〵なひく昼のしらくも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "57",
   "text": "ねやの上はつもれる盃に音もせてよこきか厳窓たてなり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "廿九",
   "side": "",
   "dai": ""
  },
  {
   "seq": "58",
   "text": "うつもるゝ松のしつえやこれならん岡へにちかき昼の一むら",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "59",
   "text": "ふきしをる嵐をこめてうつむらむふけ行山そ昼にしつまる",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅",
   "side": "",
   "dai": ""
  },
  {
   "seq": "60",
   "text": "いひかたみ心にくたすいくおもひさゑより人に知みちもかな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "61",
   "text": "思きはもみぢなきかたにしらせぬをしらぬにつけん人やつれなき",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅一",
   "side": "",
   "dai": ""
  },
  {
   "seq": "62",
   "text": "忍ひつままつとしすれはあやにくにねぬ人しけみさよそ更ゆく",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅二",
   "side": "左",
   "dai": "衛門"
  },
  {
   "seq": "63",
   "text": "一人もつゝみ我も重てとひかたみたのめしよはゝたゝ更そゆく",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅二",
   "side": "",
   "dai": "衛門"
  },
  {
   "seq": "64",
   "text": "人きもとめかくとしもなき玉章を涙なからそおしつみつる",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅三",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "65",
   "text": "しのふ程のことはりとのみおもひしをうつるかたにもきゝはしめぬる",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "66",
   "text": "契しをわすれぬ心そこにあれやたのきぬからに遣ふの久しき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅四",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "67",
   "text": "侍ことの心にすゝむけふの日はくれしとすれや餘り久しき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "68",
   "text": "明ぬなりこりねや心さしこそまたしと千度おもひつるよを",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "69",
   "text": "更もせはまたしといひしことのはゝおのか物から今そくやしき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅五",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "70",
   "text": "待わふるその久しさの程よりはまたよひすきぬ月そうれしき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅六",
   "side": "左",
   "dai": "同"
  },
  {
   "seq": "71",
   "text": "とはれんも今はよしやの明かたもまたれすはなき月のよすから",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅六",
   "side": "右",
   "dai": "同"
  },
  {
   "seq": "72",
   "text": "一人のみするおもかけなくはいかになを我みにそふもうれしからまし",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "73",
   "text": "まきれすきてさておのつからあらるゝをおもはれたちて後の夕暮",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅七",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "74",
   "text": "あまりいかゝとほさかるかたに成やせんとしはしたのめは又そかなしき",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅八",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "75",
   "text": "身に給へてされはゝのさまておもひけりといふとはかりもせめて聞はや",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "76",
   "text": "おもふとておもひもをはのあらましにはかなやそれにあわれそひぬる",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "77",
   "text": "うらむかをおもひしらぬにもてなすもそれらもつらきかたはみえけり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "卅九",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "78",
   "text": "たえすなるけにそのきはの身とまてもさすかしらすや人のつれなき",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十",
   "side": "左",
   "dai": "衛門"
  },
  {
   "seq": "79",
   "text": "身をしれはうらむることもなけれとも恋しき外に袖もぬれけり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十",
   "side": "右",
   "dai": "衛門"
  },
  {
   "seq": "80",
   "text": "夜もすからこひなく袖に月あれとみし面影はかかひしもせす",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "81",
   "text": "こすもこすたのましまたしわすれんと思なからも月になかめて",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十一",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "82",
   "text": "あすしらぬうき世はかりをなけはや命をきはの中とさゝにて",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十二",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "83",
   "text": "おなし世にわかさきたちて恋しなは君か心の後そゆかしき",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "84",
   "text": "うきうらみ恋しきあはれいつかたにまさるおもひと心をそ見る",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "一四十三",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "85",
   "text": "さらしまたしのひまさるときくからにうさもつらさもいはすゐるよろ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "一四十三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "86",
   "text": "ゑはしたゝよくとも人にゑたかはてうらみのきける我そく中き",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十四",
   "side": "左",
   "dai": "え"
  },
  {
   "seq": "87",
   "text": "おもひとりし昨日のうきはまくれはやけふはまつそと又いはれぬる",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十四",
   "side": "",
   "dai": "え"
  },
  {
   "seq": "88",
   "text": "よしや人いかにもうかれそれにさらにとかくはおもはれぬものを",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "89",
   "text": "人のとかにおもひとかめぬふし〳〵もうくなりはてはうさにこそなれ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十五",
   "side": "",
   "dai": ""
  },
  {
   "seq": "90",
   "text": "おひつさもうかりけりと思ふ後に又恋しきそことのはもなき",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十六",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "91",
   "text": "をりくのこれやかきりの成おもひそのあはれさはしる人もなし",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十六",
   "side": "",
   "dai": ""
  },
  {
   "seq": "92",
   "text": "あくかるゝたまのゆくへに恋しとも思はぬ夢にいりかぬら舞",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "93",
   "text": "なれてみし面かけをめてわすられよたちそへはこそ恋しさもそへ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十七",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "94",
   "text": "かはらしと老のむきはまてゆるしける我はさそいひてかひなき",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十八",
   "side": "左",
   "dai": "へ"
  },
  {
   "seq": "95",
   "text": "をりにふれてうき哀さはかはれとも君ゆゑならぬ思ひしもなし",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十八",
   "side": "右",
   "dai": "へ"
  },
  {
   "seq": "96",
   "text": "いとふとも同し世はかりゆるさなん有てよ所にもおもひやるへく",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "97",
   "text": "ことのはにいてゝうらみはつきはてゝ心にこむるうさになりぬる",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "四十九",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "98",
   "text": "そのまゝにそはましみましいたつゝにをしやあはれや其所のとし月",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "99",
   "text": "命こそいとひなからもあはれなれうきをもからてみみくと思へは",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "100",
   "text": "ふけぬるかすき行里もしつまりて月のよみちにあふ人もなし",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "101",
   "text": "とまるへき宿をは月にあくかれてあすのみちゆく夜半の旅人",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十一",
   "side": "",
   "dai": ""
  },
  {
   "seq": "102",
   "text": "ぬるゝかとたちやすらへは松かけや風のきかせる雨にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十二",
   "side": "左",
   "dai": "に"
  },
  {
   "seq": "103",
   "text": "旅の空雨のふる日は暮ぬかと思て後もゆくそひさしき",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十二",
   "side": "右",
   "dai": "に"
  },
  {
   "seq": "104",
   "text": "こへてこそいくへの峯としられけれみしはなへそのよ所の山場",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十三",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "105",
   "text": "ふもとなる草にはしけき山嵐の峯の松にはふへかともなし",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "106",
   "text": "やむましき雨のけしきになりけらしちかき尾上も雲に消ゆく",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十四",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "107",
   "text": "大そらはあまねくおほふ雲の心くにつちうかふ雨くたすなり",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "108",
   "text": "をちこちの夕日の山は色くれてすそ野をわたる浮雲のかけ",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "109",
   "text": "雨ふれて雲おりかゝる山まつのふもとに残る数そすくなき",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十五",
   "side": "",
   "dai": ""
  },
  {
   "seq": "110",
   "text": "雨のおとのきこゆる窓はさよ交てぬれぬにしめるともし火の影",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十六",
   "side": "左",
   "dai": "衛門"
  },
  {
   "seq": "111",
   "text": "ふりよはり又ふりまさり夜もすからたゆまぬ雨の音に明ぬる",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十六",
   "side": "右",
   "dai": "衛門"
  },
  {
   "seq": "112",
   "text": "つくろはぬ岩木をもとの姿にてやとめつらしき山のおくかな",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "113",
   "text": "身はかくてしはしとおもふ山さとに心をかへすみねのまつ風",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十七",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "114",
   "text": "かさりいふことはのうへはまよへともはつれて人のこゝろをそみる",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十八",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "115",
   "text": "おもひみる心のまゝに言葉のゆたかにかなふ時そうれしき",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "五十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "116",
   "text": "なさけをも知人なみのもしほるかきおくあとの数のみそそふ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-729564",
   "form": "短歌",
   "genre": "",
   "ban": "九十九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "117",
   "text": "世にこゆる君かことのは玉はあれと光のそこを見るへやなき",
   "kana": "",
